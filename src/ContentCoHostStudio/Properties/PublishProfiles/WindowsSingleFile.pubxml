<Project>
  <Import Project="WindowsPortable.pubxml" />
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Vosk models and external FFmpeg tools require real filesystem paths.
         Extract all bundled content so AppContext.BaseDirectory remains compatible. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(BundledDocumentationDirectory)' != ''">
    <Content Include="$(BundledDocumentationDirectory)/**/*"
             Link="%(RecursiveDir)%(Filename)%(Extension)"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireBundledNotices" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(BundledDocumentationDirectory)' == '' Or !Exists('$(BundledDocumentationDirectory)/licenses/DotNet-10.0.15-LICENSE.TXT')"
           Text="Use scripts/package_single_file.py to include the dependency notices in the executable." />
  </Target>
</Project>
